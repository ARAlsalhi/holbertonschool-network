#!/usr/bin/env bash
# Change localhost and facebook.com IP addresses

hosts=$(sed -E \
    -e 's/^127\.0\.0\.1[[:space:]]+localhost/127.0.0.2 localhost/' \
    -e '/[[:space:]]facebook\.com([[:space:]]|$)/d' \
    /etc/hosts) || exit 1

printf '%s\n8.8.8.8 facebook.com\n' "$hosts" | sudo tee /etc/hosts > /dev/null
